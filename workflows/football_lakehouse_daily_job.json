{
  "name": "football-lakehouse-daily",
  "description": "Raw -> Bronze -> Silver -> Gold. Each stage is a dependent task: Gold only starts if Silver succeeded, so the dashboard never reads a half-updated state. All three tasks share one batch id so a run can be traced through every layer in ops/pipeline_execution_logs.",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "parameters": [
    { "name": "snapshot_date", "default": "" },
    { "name": "load_type", "default": "INCREMENTAL" }
  ],
  "tasks": [
    {
      "task_key": "raw_to_bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/<your-user>/football-analytics-lakehouse/notebooks/job_daily_pipeline",
        "base_parameters": {
          "stage": "bronze",
          "load_type": "{{job.parameters.load_type}}",
          "snapshot_date": "{{job.parameters.snapshot_date}}",
          "batch_id": "run_{{job.run_id}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "bronze_to_silver",
      "depends_on": [{ "task_key": "raw_to_bronze" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/<your-user>/football-analytics-lakehouse/notebooks/job_daily_pipeline",
        "base_parameters": {
          "stage": "silver",
          "load_type": "{{job.parameters.load_type}}",
          "snapshot_date": "{{job.parameters.snapshot_date}}",
          "batch_id": "run_{{job.run_id}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver_to_gold",
      "depends_on": [{ "task_key": "bronze_to_silver" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/<your-user>/football-analytics-lakehouse/notebooks/job_daily_pipeline",
        "base_parameters": {
          "stage": "gold",
          "load_type": "{{job.parameters.load_type}}",
          "snapshot_date": "{{job.parameters.snapshot_date}}",
          "batch_id": "run_{{job.run_id}}"
        }
      },
      "max_retries": 0
    }
  ]
}
